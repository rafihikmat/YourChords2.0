# 21st.dev Component Registry Authentication API Key (CI/CD Pipeline & Headless Auth)
# Used by @21st-dev/cli for non-interactive logins in CI/CD via: 21st add --api-key $API_KEY_21ST
API_KEY_21ST=your_21st_dev_api_key_here

# Supabase Authentication & Database Services
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
